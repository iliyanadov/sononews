# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sononews

# Redis
REDIS_URL=redis://localhost:6379

# TwitterAPI.io
TWITTER_API_KEY=your_twitterapiio_key_here
TWITTER_SOURCE_ACCOUNT=Kurrco

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Custom Search
GOOGLE_CSE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_search_engine_id_here

# App
NODE_ENV=development
USE_MOCK_SCRAPER=true
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
