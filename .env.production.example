# ===========================================
# SonoNews Production Environment Variables
# ===========================================
# Copy this file to .env.production and fill in the values
# DO NOT commit .env.production to git

# ===========================================
# Service URLs (Railway)
# ===========================================
# These are assigned by Railway after deployment
# Update them to cross-reference both services

# API Service URL (for web service to call)
# Example: https://sononews-api.up.railway.app
NEXT_PUBLIC_API_URL=https://your-api-service.up.railway.app

# Web Service URL (for API CORS)
# Example: https://sononews-web.up.railway.app
FRONTEND_URL=https://your-web-service.up.railway.app

# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
# Get both URLs from Neon dashboard:
# - DATABASE_URL: Pooled connection (with -pooler in hostname)
# - DIRECT_DATABASE_URL: Direct connection (without -pooler)
# Example: postgresql://user:pass@ep-xxx.pooler.us-east-1.aws.neon.tech/db
DATABASE_URL=postgresql://user:password@host-neon-pooler.region.aws.neon.tech/neondb
DIRECT_DATABASE_URL=postgresql://user:password@host-region.aws.neon.tech/neondb

# ===========================================
# Redis (Upstash)
# ===========================================
# Get from Upstash dashboard
# Note the 'rediss://' protocol (double s for TLS)
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ===========================================
# AI Providers
# ===========================================
# Anthropic Claude (Primary in production)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini (Fallback)
GEMINI_API_KEY=AIzaSy...

# ===========================================
# Twitter/X Scraper
# ===========================================
# Get from https://twitterapi.io/
TWITTER_API_KEY=new1_xxxxx
TWITTER_SOURCE_ACCOUNT=Kurrco

# ===========================================
# Application Settings
# ===========================================
# Node environment
NODE_ENV=production

# API Port (only used locally, ignored in Railway)
# Railway sets PORT dynamically
PORT=3001

# Scraper mode (set to false to use real Twitter API)
USE_MOCK_SCRAPER=false

# ===========================================
# Railway Service Configuration
# ===========================================
# Railway automatically sets PORT for each service
# API Service: apps/api/Dockerfile
# Web Service: apps/web/Dockerfile
# Both services are deployed in the same Railway project
